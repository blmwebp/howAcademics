{
  "name": "@howacademics/api",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate --schema ../../prisma/schema.prisma && tsc",
    "start": "node dist/index.js",
    "bootstrap": "tsx src/bootstrap.ts",
    "seed:demo": "tsx src/seedDemo.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@howacademics/contracts": "file:../../packages/contracts",
    "@howacademics/config": "file:../../packages/config",
    "@prisma/client": "^6.1.0",
    "argon2": "^0.31.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "pdfkit": "^0.17.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/pdfkit": "^0.17.2",
    "@types/node": "^22.10.2",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
